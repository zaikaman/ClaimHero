# ==============================================================================
# ClaimHero Environment Configuration Template
# ==============================================================================

# 1. Convex Backend Deployment & URL
CONVEX_DEPLOYMENT=dev:claimhero-example
VITE_CONVEX_URL=https://your-convex-deployment.convex.cloud

# 2. OpenAI AI Client (3 Explicit Config Variables)
# Supports gpt-5-nano reasoning engine and full custom proxy endpoints
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_MODEL=gpt-5-nano
OPENAI_BASE_URL=https://api.openai.com/v1

# 3. Firecrawl (Insurer Clinical Policy Bulletins & Guidelines Scraper)
FIRECRAWL_API_KEY=fc-your-firecrawl-api-key

# 4. AgentMail (Autonomous Claim Email Inboxes & Outbound Transmission)
AGENTMAIL_API_KEY=am_your_agentmail_api_key
