# ==============================================================================
# ClaimHero Environment Configuration Template
# ==============================================================================

# 1. Convex Backend Deployment & URL (frontend Vite vars)
CONVEX_DEPLOYMENT=dev:claimhero-example
VITE_CONVEX_URL=https://your-convex-deployment.convex.cloud
# Frontend copy of the hosted app origin. In production this is the same origin
# as SITE_URL below. Falls back to VITE_CONVEX_URL with `.convex.cloud`
# swapped for `.convex.site` when unset.
VITE_CONVEX_SITE_URL=https://your-convex-deployment.convex.site

# 2. REQUIRED Convex backend env (convex/convex.config.ts `v.string()`)
# Set these on the Convex deployment with `npx convex env set NAME value`.
# They are NOT read from Vite `.env.local`. A fresh deploy without them fails
# `convex deploy` schema validation, and `SITE_URL` also fails loudly at
# runtime in `convex/auth.ts`, `convex/lib/appealEmail.ts`, and
# `convex/actions/agentMail.ts` when unset or not a valid http(s) URL.
# Production value: your hosted app origin (e.g. https://<deployment>.convex.site).
# Local dev value: http://localhost:5173
SITE_URL=https://your-convex-deployment.convex.site

# Convex Auth RS256 signing keypair. AUTH_PRIVATE_KEY must be the base64-encoded
# PKCS8 PEM (`Buffer.from(pem).toString("base64")`). AUTH_JWKS is the matching
# public JWKS document (`{"keys":[{"use":"sig",...}]}`). Generate with:
# node -e 'import("jose").then(async({generateKeyPair,exportPKCS8,exportJWK})=>{const k=await generateKeyPair("RS256",{extractable:true});const priv=await exportPKCS8(k.privateKey);const pub=await exportJWK(k.publicKey);console.log("AUTH_PRIVATE_KEY="+Buffer.from(priv).toString("base64"));console.log("AUTH_JWKS="+JSON.stringify({keys:[{use:"sig",...pub}]}))})'
# Then set each value with `npx convex env set AUTH_PRIVATE_KEY ...` and
# `npx convex env set AUTH_JWKS ...` (quote the value; it starts with base64
# data and the JWKS contains shell-special characters).
AUTH_PRIVATE_KEY=LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0t...
AUTH_JWKS={"keys":[{"use":"sig","kty":"RSA","kid":"example-key-id","alg":"RS256","n":"...","e":"AQAB"}]}

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Required by the `oauthGoogle` component in convex/convex.config.ts:58-65.
# Authorize the SITE_URL origin as a redirect origin for sign-in.
AUTH_GOOGLE_ID=your-google-oauth-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-your-google-oauth-client-secret

# 3. OpenAI AI Client (optional for `convex deploy`, REQUIRED at runtime for AI paths)
# convex/convex.config.ts marks these `v.optional(v.string())`, so deploy
# succeeds without them, but sponsor paths fail closed:
# - convex/lib/openai.ts:17-22 throws when OPENAI_API_KEY is missing
#   (extraction, drafting, chat).
# - convex/lib/openai.ts:302-307 throws when OPENAI_EMBEDDING_MODEL is missing
#   (Precedent Vector Archive embedding). Set all four on the Convex deployment
#   before evaluating AI, scoring, or precedent search.
# Supports gpt-5.4-nano reasoning engine and full custom proxy endpoints
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_MODEL=gpt-5.4-nano
OPENAI_BASE_URL=https://api.openai.com/v1
# Required at runtime for vector embeddings in Precedent Vector Archive
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 4. Firecrawl (Insurer Clinical Policy Bulletins & Guidelines Scraper)
# FIRECRAWL_API_KEY is REQUIRED (v.string()). FIRECRAWL_WEBHOOK_SECRET is
# OPTIONAL (v.optional) and only needed to verify signed Firecrawl webhooks.
FIRECRAWL_API_KEY=fc-your-firecrawl-api-key
FIRECRAWL_WEBHOOK_SECRET=whsec_your_firecrawl_webhook_secret

# 5. AgentMail (Autonomous Claim Email Inboxes & Outbound Transmission)
# AGENTMAIL_API_KEY and AGENTMAIL_WEBHOOK_SECRET are REQUIRED (v.string()).
# AGENTMAIL_SENDER_INBOX_ID / AGENTMAIL_SENDER_EMAIL are optional for deploy
# (v.optional) but REQUIRED at runtime: convex/lib/agentMail.ts:101-105 and
# convex/actions/agentMail.ts:819-824 throw when the shared sender mailbox or
# SITE_URL is unset, so payer dispatch and reply sync stay disabled until set.
# Shared sender inbox model: create this inbox once in the AgentMail console.
AGENTMAIL_API_KEY=am_your_agentmail_api_key
AGENTMAIL_WEBHOOK_SECRET=whsec_your_agentmail_webhook_secret
AGENTMAIL_SENDER_INBOX_ID=your_sender_inbox_id
AGENTMAIL_SENDER_EMAIL=claimhero-sender@agentmail.to

# 6. AWS Textract (OPTIONAL for server-side high-accuracy table extraction)
# In-browser OCR (pdf.js getTextContent + tesseract.js) handles digital PDFs and scans
# with zero keys and zero BAA required. When AWS credentials are configured in Convex,
# Textract is used as an optional enhancement for advanced tabular extraction.
AWS_ACCESS_KEY_ID=AKIA_YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1

# Frontend VITE_ aliases for AgentMail addresses
VITE_AGENTMAIL_SENDER_EMAIL=claimhero-sender@agentmail.to

