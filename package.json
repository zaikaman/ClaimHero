{
  "name": "claimhero",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src convex",
    "test": "vitest run tests",
    "test:coverage": "vitest run tests --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run build",
    "deploy": "npx @convex-dev/static-hosting deploy"
  },
  "dependencies": {
    "@convex-dev/aggregate": "^0.3.0",
    "@convex-dev/auth": "^2.0.0-alpha.1",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/static-hosting": "^0.2.1",
    "@firecrawl/firecrawl-convex": "^0.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@react-three/fiber": "^8.18.0",
    "@types/three": "^0.170.0",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "jose": "^6.2.10",
    "openai": "^4.85.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
